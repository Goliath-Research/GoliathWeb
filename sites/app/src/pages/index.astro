---
import { brand } from "@goliath/ui/brand";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="GoliathApp"
  documentTitle="GoliathApp"
  description="Placeholder for the GoliathApp platform site at app.goliathresearch.com."
>
  <section class="hero">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">app.goliathresearch.com</p>
      <h1>GoliathApp</h1>
      <p class="lede">
        This host will be the GoliathApp platform site. The page is a placeholder so the site can build
        and deploy on its own.
      </p>
      <p>
        The company description and the product page generated from <code>.goliath/product.json</code>
        are on the global site.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`${brand.hosts.www}/platform/`}>Platform on the company site</a>
        <a class="btn btn-ghost" href={`${brand.hosts.www}/products/goliathapp/`}>Product page</a>
        <a class="btn btn-ghost" href="https://github.com/Goliath-Research/GoliathApp" rel="noreferrer">Repository</a>
      </div>
    </div>
  </section>
</Layout>
