---
import { requireProduct, type Product } from "@goliath/catalog";
import {
  formatList,
  productDomainLabel,
  productUserSummary,
  statusClass,
  statusLabel,
} from "../lib/display.ts";

interface Props {
  products: Product[];
}

const { products } = Astro.props;
const platform = requireProduct(products, "goliathapp");
const omics = requireProduct(products, "goliathomics");
const ground = requireProduct(products, "goliathgroundstation");
const crop = requireProduct(products, "goliathcrop");
const factory = requireProduct(products, "goliathfactory");
const realty = requireProduct(products, "goliathrealty");
const align = requireProduct(products, "goliathalign");
const extractor = requireProduct(products, "goliath-extractor");

function relationshipLabel(product: Product): string {
  if (product.id === "goliathapp") {
    return "Shared foundation for all Goliath domain applications.";
  }
  if (product.id === "goliathalign" || product.id === "goliath-extractor") {
    return "Standalone command-line tool · Also integrated into GoliathOmics.";
  }
  const names = product.dependsOn.map((id) => requireProduct(products, id).name);
  return `Built on ${formatList(names)}.`;
}

const standaloneUtilities = [align, extractor];
const activeApps = [omics, ground];
const plannedApps = [crop, factory, realty];
---

<figure class="hierarchy">
  <figcaption>
    Our software consists of standalone bioinformatics utilities that are ready to use today, the shared{" "}
    <strong>GoliathApp</strong> platform and active reference applications, and planned domain applications
    open for industry pilots.
  </figcaption>

  <div class="hierarchy-tiers">
    <div class="hierarchy-tier">
      <div class="hierarchy-tier-header">
        <p class="hierarchy-tier-label">Available Today · Standalone Bioinformatics &amp; Compute Tools</p>
        <span class="chip status-live">Ready to Use</span>
      </div>
      <p class="hierarchy-tier-desc">
        High-performance command-line tools that researchers and engineers can run independently today, or
        invoke inside automated GoliathOmics pipelines:
      </p>
      <div class="hierarchy-row hierarchy-row-two">
        {
          standaloneUtilities.map((product) => (
            <article class="node node-utility">
              <p class="meta-row">
                <span class="chip">{productDomainLabel(product.id, product.category)}</span>
                <span class:list={["chip", statusClass(product.status, product.id)]}>
                  {statusLabel(product.status, product.id)}
                </span>
              </p>
              <a class="node-title" href={`/products/${product.id}/`}>
                {product.name}
              </a>
              <p class="node-tagline">{productUserSummary(product.id, product.tagline)}</p>
              <p class="node-dep">{relationshipLabel(product)}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="hierarchy-tier">
      <div class="hierarchy-tier-header">
        <p class="hierarchy-tier-label">In Active Development · Core Application Platform</p>
        <span class="chip status-early">Platform Initiative</span>
      </div>
      <div class="hierarchy-row hierarchy-row-platform">
        <article class="node node-platform">
          <p class="meta-row">
            <span class="chip">{productDomainLabel(platform.id, platform.category)}</span>
            <span class:list={["chip", statusClass(platform.status, platform.id)]}>
              {statusLabel(platform.status, platform.id)}
            </span>
          </p>
          <a class="node-title" href={`/products/${platform.id}/`}>
            {platform.name}
          </a>
          <p class="node-tagline">{productUserSummary(platform.id, platform.tagline)}</p>
          <p class="node-dep">{relationshipLabel(platform)}</p>
        </article>
      </div>

      <div class="hierarchy-connector" aria-hidden="true">
        ↓ Powers domain-specific reference applications
      </div>

      <div class="hierarchy-tier-header" style="margin-top: 0.5rem;">
        <p class="hierarchy-tier-label">Active Reference Applications on GoliathApp</p>
        <span class="chip status-early">Pilot Validation</span>
      </div>
      <div class="hierarchy-row hierarchy-row-two">
        {
          activeApps.map((product) => (
            <article class="node node-app-active">
              <p class="meta-row">
                <span class="chip">{productDomainLabel(product.id, product.category)}</span>
                <span class:list={["chip", statusClass(product.status, product.id)]}>
                  {statusLabel(product.status, product.id)}
                </span>
              </p>
              <a class="node-title" href={`/products/${product.id}/`}>
                {product.name}
              </a>
              <p class="node-tagline">{productUserSummary(product.id, product.tagline)}</p>
              <p class="node-dep">{relationshipLabel(product)}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="hierarchy-tier">
      <div class="hierarchy-tier-header">
        <p class="hierarchy-tier-label">Planned Domain Applications on GoliathApp</p>
        <span class="chip status-planned">Planned · Seeking Pilot Partners</span>
      </div>
      <p class="hierarchy-tier-desc">
        Published domain architectures where we seek industry partners with focused operational problems for
        measurable pilots:
      </p>
      <div class="hierarchy-row hierarchy-row-three">
        {
          plannedApps.map((product) => (
            <article class="node node-app-planned">
              <p class="meta-row">
                <span class="chip">{productDomainLabel(product.id, product.category)}</span>
                <span class:list={["chip", statusClass(product.status, product.id)]}>
                  {statusLabel(product.status, product.id)}
                </span>
              </p>
              <a class="node-title" href={`/products/${product.id}/`}>
                {product.name}
              </a>
              <p class="node-tagline">{productUserSummary(product.id, product.tagline)}</p>
              <p class="node-dep">{relationshipLabel(product)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<style>
  .hierarchy {
    margin: 1.75rem 0;
  }

  .hierarchy figcaption {
    margin-bottom: 1.25rem;
    color: var(--muted);
    max-width: 52rem;
  }

  .hierarchy-tiers {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hierarchy-tier {
    background: rgba(255, 252, 248, 0.65);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    padding: 1.25rem 1.35rem 1.4rem;
  }

  .hierarchy-tier-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.65rem;
  }

  .hierarchy-tier-label {
    margin: 0;
    color: var(--accent);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .hierarchy-tier-desc {
    margin: 0 0 0.9rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  .hierarchy-connector {
    text-align: center;
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--accent);
    padding: 0.85rem 0 0.35rem;
  }

  .hierarchy-row {
    display: grid;
    gap: 1rem;
  }

  .hierarchy-row-platform {
    grid-template-columns: 1fr;
  }

  .hierarchy-row-two {
    grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
  }

  .hierarchy-row-three {
    grid-template-columns: repeat(auto-fit, minmax(18.5rem, 1fr));
  }

  .node {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.95rem;
    padding: 1.25rem 1.35rem;
    box-shadow: var(--shadow);
    min-width: 0;
    overflow-wrap: break-word;
  }

  .node-platform {
    border-top: 3px solid var(--accent);
  }

  .node-app-active {
    border-left: 3px solid var(--accent);
  }

  .node-app-planned {
    border-style: dashed;
  }

  .node-utility {
    border-left: 3px solid var(--accent-ink);
  }

  .node-title {
    display: inline-block;
    font-family: var(--serif);
    font-size: 1.45rem;
    line-height: 1.25;
    text-decoration: none;
    margin-bottom: 0.4rem;
    word-break: break-word;
  }

  .node-tagline {
    margin: 0 0 0.55rem;
    font-size: 0.98rem;
    color: var(--ink);
  }

  .node-dep {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .hierarchy-row-two,
    .hierarchy-row-three {
      grid-template-columns: 1fr;
    }
  }
</style>
