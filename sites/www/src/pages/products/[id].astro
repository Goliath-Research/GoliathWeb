---
import {
  consumersOf,
  loadProducts,
  requireProduct,
  type Product,
} from "@goliath/catalog";
import Markdown from "../../components/Markdown.astro";
import {
  categoryLabel,
  emptyDependencyNote,
  productDomainLabel,
  productUserSummary,
  statusClass,
  statusLabel,
} from "../../lib/display.ts";
import { safeUrl } from "../../lib/markdown.ts";
import Layout from "../../layouts/Layout.astro";

interface Props {
  product: Product;
}

export async function getStaticPaths() {
  const products = await loadProducts();
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const products = await loadProducts();
const consumers = consumersOf(products, product.id);
const dependencies = product.dependsOn.map((id) => requireProduct(products, id));
const related = product.related.map((id) => requireProduct(products, id));

function httpsHref(value: string | null): string | undefined {
  if (!value) return undefined;
  return safeUrl(value);
}

const repository = httpsHref(product.links.repository);
const website = httpsHref(product.links.website);
const publishedDocs = httpsHref(product.links.docs);
const docsSource = repository ? `${repository.replace(/\/$/, "")}/tree/${product.source.ref}/docs` : undefined;
const isPlanned = ["goliathcrop", "goliathfactory", "goliathrealty"].includes(product.id);
---

<Layout title={product.name} description={productUserSummary(product.id, product.tagline)}>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">
        <span class="chip">{productDomainLabel(product.id, product.category)}</span>
        <span class="chip">{categoryLabel(product.category)}</span>
        <span class:list={["chip", statusClass(product.status, product.id)]}>
          {statusLabel(product.status, product.id)}
        </span>
        <span class="chip">License: {product.license}</span>
      </p>
      <h1>{product.name}</h1>
      <p class="lede">{productUserSummary(product.id, product.tagline)}</p>
      {
        product.id === "goliathalign" && (
          <p class="prose">
            <strong>Current status:</strong> GoliathAlign is ready and working today for linear and pangenome
            sequence alignment on both <strong>NVIDIA</strong> and <strong>AMD</strong> GPU platforms, with
            continuous development to implement additional features and expand to other hardware platforms.
          </p>
        )
      }
      {
        isPlanned && (
          <p class="prose">
            <strong>Planned domain application:</strong> {product.name} is a planned domain adaptation on{" "}
            <a href="/products/goliathapp/">GoliathApp</a>. We are seeking industry and research partners with
            a focused operational problem suitable for a small, measurable pilot.{" "}
            <a href="/partnerships/">Learn about pilot partnerships →</a>
          </p>
        )
      }
      <Markdown source={product.description} />
      <div class="cta-row">
        {repository && <a class="btn btn-primary" href={repository} rel="noreferrer">GitHub Repository</a>}
        {
          publishedDocs ? (
            <a class="btn btn-ghost" href={publishedDocs} rel="noreferrer">
              Documentation
            </a>
          ) : (
            docsSource && (
              <a class="btn btn-ghost" href={docsSource} rel="noreferrer">
                Documentation in repository
              </a>
            )
          )
        }
        {website && <a class="btn btn-ghost" href={website} rel="noreferrer">Website</a>}
        <a class="btn btn-ghost" href="/products/">All products</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Key features &amp; capabilities</h2>
      <div class="feature-grid">
        {
          product.features.map((feature) => (
            <article class="card">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Architecture &amp; stack relationships</h2>
      <div class="pillar-grid">
        <article class="card">
          <h3>Built on / Integrates</h3>
          {
            dependencies.length === 0 ? (
              <p>{emptyDependencyNote(product.id)}</p>
            ) : (
              <ul>
                {dependencies.map((dependency) => (
                  <li>
                    <a href={`/products/${dependency.id}/`}>{dependency.name}</a> —{" "}
                    {productDomainLabel(dependency.id, dependency.category)}
                  </li>
                ))}
              </ul>
            )
          }
        </article>

        <article class="card">
          <h3>Used by</h3>
          {
            consumers.length === 0 ? (
              <p>This is a top-level application and is not a dependency of other catalog products.</p>
            ) : (
              <ul>
                {consumers.map((consumer) => (
                  <li>
                    <a href={`/products/${consumer.id}/`}>{consumer.name}</a> —{" "}
                    {productDomainLabel(consumer.id, consumer.category)}
                  </li>
                ))}
              </ul>
            )
          }
        </article>

        <article class="card">
          <h3>Related software</h3>
          {
            related.length === 0 ? (
              <p>Standalone component with no required companion software.</p>
            ) : (
              <ul>
                {related.map((item) => (
                  <li>
                    <a href={`/products/${item.id}/`}>{item.name}</a> —{" "}
                    {productDomainLabel(item.id, item.category)}
                  </li>
                ))}
              </ul>
            )
          }
        </article>
      </div>
    </div>
  </section>
</Layout>
