---
import { loadProducts, requireProduct } from "@goliath/catalog";
import { brand } from "@goliath/ui/brand";
import Markdown from "../../components/Markdown.astro";
import { safeUrl } from "../../lib/markdown.ts";
import Layout from "../../layouts/Layout.astro";

const products = await loadProducts();
const omics = requireProduct(products, "goliathomics");
const align = requireProduct(products, "goliathalign");
const extractor = requireProduct(products, "goliath-extractor");
const processPacks = omics.features.find((feature) => /process pack/i.test(feature.title));
const publishedDocs = omics.links.docs ? safeUrl(omics.links.docs) : undefined;
const workflowDiagrams = publishedDocs ? `${publishedDocs.replace(/\/$/, "")}/workflows/` : undefined;
---

<Layout
  title="GoliathOmics"
  description={`GoliathOmics is the genomics reference application built on GoliathApp, integrating GoliathAlign, ${extractor.name}, and domain process packs.`}
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Reference Application · Genomics &amp; Bioinformatics</p>
      <h1>{omics.name}</h1>
      <p class="lede">{omics.tagline}</p>
      <p class="prose">
        <strong>{omics.name}</strong> is our primary scientific reference application validating the{" "}
        <a href="/technology/">GoliathApp platform</a> against real-world bioinformatics workflows. It extends
        GoliathApp and integrates two ready, standalone open-source utilities:{" "}
        <a href={`/products/${align.id}/`}>{align.name}</a> (working for linear and pangenome alignment on
        NVIDIA and AMD platforms, with continuous development for additional features and hardware platforms)
        and <a href={`/products/${extractor.id}/`}>{extractor.name}</a> (a performance-optimized fork of
        MethylDackel focused on methylation extraction), plus domain process packs.
      </p>
      <p class="prose">
        {align.name} and {extractor.name} are standalone command-line utilities that do not require or depend on
        GoliathApp or {omics.name}. Conversely, GoliathApp remains domain-neutral and does not reference
        downstream applications.
      </p>
      <Markdown source={omics.description} />
      {
        processPacks && (
          <article class="card">
            <h2>{processPacks.title}</h2>
            <p>{processPacks.description}</p>
          </article>
        )
      }
      <div class="cta-row">
        <a class="btn btn-primary" href={`/products/${omics.id}/`}>Product page</a>
        {
          workflowDiagrams && (
            <a class="btn btn-ghost" href={workflowDiagrams} rel="noreferrer">
              Workflow diagrams
            </a>
          )
        }
        {
          publishedDocs && (
            <a class="btn btn-ghost" href={publishedDocs} rel="noreferrer">
              Documentation
            </a>
          )
        }
        <a class="btn btn-ghost" href="/technology/">Technology overview</a>
        <a class="btn btn-ghost" href="/partnerships/">Research partnerships</a>
        <a class="btn btn-ghost" href={`/products/${align.id}/`}>{align.name}</a>
        <a class="btn btn-ghost" href={`/products/${extractor.id}/`}>{extractor.name}</a>
        <a class="btn btn-ghost" href={brand.hosts.omics}>omics.goliathresearch.com</a>
      </div>
      <p class="note">
        We are seeking research partners with well-defined genomics and bioinformatics workflows against which
        to validate {omics.name}. The live operator host is{" "}
        <a href={brand.hosts.omics}>{brand.hosts.omics.replace("https://", "")}</a>, listed with other live
        application hosts on the <a href="/apps/">Apps</a> page.
      </p>
    </div>
  </section>
</Layout>
