---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Not found" description="That page is not on the Goliath Research site.">
  <section class="hero">
    <div class="wrap wrap-narrow">
      <h1>Page not found</h1>
      <p class="lede">That path is not on this site.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/products/">Products</a>
      </div>
    </div>
  </section>
</Layout>
