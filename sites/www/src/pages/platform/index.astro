---
import { loadProducts, requireProduct } from "@goliath/catalog";
import { brand } from "@goliath/ui/brand";
import Markdown from "../../components/Markdown.astro";
import Layout from "../../layouts/Layout.astro";

const platform = requireProduct(await loadProducts(), "goliathapp");
const spotlights = [
  /role-based access control/i,
  /workflow engine/i,
  /user-defined actions/i,
  /distributed workers/i,
];
const highlighted = platform.features.filter((feature) =>
  spotlights.some((pattern) => pattern.test(feature.title)),
);
---

<Layout
  title="GoliathApp"
  description="GoliathApp is the Goliath Research platform initiative: role-based access control, workflow orchestration, user-defined actions, and distributed workers."
>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Platform Initiative · {platform.name}</p>
      <h1>{platform.name}</h1>
      <p class="lede">
        We are developing a reusable platform for building data-intensive applications, with the goal of
        adapting shared capabilities to the needs of different scientific and industrial domains.
      </p>
      <p class="prose">
        <strong>{platform.name}</strong> provides role-based access control, a workflow engine, declarative
        semantic schemas, user-defined actions, and distributed workers. Reference applications such as{" "}
        <a href="/omics/">GoliathOmics</a> and{" "}
        <a href="/products/goliathgroundstation/">GoliathGroundStation</a>—along with planned domain
        adaptations (<a href="/products/goliathcrop/">GoliathCrop</a>,{" "}
        <a href="/products/goliathfactory/">GoliathFactory</a>, and{" "}
        <a href="/products/goliathrealty/">GoliathRealty</a>)—extend it without coupling the core platform to any
        single industry.
      </p>
      <Markdown source={platform.description} />
      <div class="cta-row">
        <a class="btn btn-primary" href="/technology/">Technology &amp; demonstration</a>
        <a class="btn btn-ghost" href="/partnerships/">Propose a pilot</a>
        <a class="btn btn-ghost" href="/products/goliathapp/">Product page</a>
        <a class="btn btn-ghost" href={platform.links.repository} rel="noreferrer">Repository</a>
        <a class="btn btn-ghost" href={brand.hosts.app}>app.goliathresearch.com</a>
      </div>
      <p class="note">
        <code>app.goliathresearch.com</code> is the live GoliathApp platform host (the signed-in operator
        portal). It is not a static site in this repository. Live application hosts are listed on the{" "}
        <a href="/apps/">Apps</a> page.
      </p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <h2>Verified capabilities from the manifest</h2>
      <div class="feature-grid">
        {
          highlighted.map((feature) => (
            <article class="card">
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
