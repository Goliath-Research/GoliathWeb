---
import type { FooterLink } from "./types.ts";

interface Props {
  blurb: string;
  links: FooterLink[];
}

const { blurb, links } = Astro.props;
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <p class="footer-brand">Goliath Research Inc</p>
    <p class="footer-blurb">{blurb}</p>
    <ul class="footer-links">
      {
        links.map((link) => (
          <li>
            <a href={link.href} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
