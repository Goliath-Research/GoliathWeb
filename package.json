{
  "name": "goliath-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/*",
    "sites/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "validate:products": "tsx scripts/validate-products.ts",
    "fetch:semantic-catalogs": "npm run fetch:catalogs --workspace @goliath/semantic",
    "generate:semantic-types": "npm run generate:types --workspace @goliath/semantic",
    "check:semantic-types": "npm run check:semantic-types --workspace @goliath/semantic",
    "dev:www": "npm run dev --workspace @goliath/www",
    "dev:app": "npm run dev --workspace @goliath/app",
    "dev:omics": "npm run dev --workspace @goliath/omics"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "@types/node": "^24.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
